---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="404 页面不存在">
  <section class="hero">
    <div class="wrap">
      <p class="hero-kicker">404</p>
      <h1>这个页面不存在</h1>
      <p>链接可能失效了，或者文章已被重命名。</p>
      <div class="hero-links">
        <a class="btn btn-primary" href="/">回到首页</a>
        <a class="btn" href="/search">搜索全站</a>
      </div>
    </div>
  </section>
</BaseLayout>
