---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryList from '../../components/EntryList.astro';
import { CATEGORY_META, type CategoryKey } from '../../lib/utils';

export async function getStaticPaths() {
  const keys: CategoryKey[] = ['notes', 'projects', 'books', 'resources'];
  const map = new Map<string, any[]>();

  for (const key of keys) {
    const entries = await getCollection(key);
    for (const e of entries) {
      if (e.data.draft) continue;
      for (const t of e.data.tags) {
        if (!map.has(t)) map.set(t, []);
        map.get(t)!.push({
          id: e.id,
          title: e.data.title,
          description: e.data.description,
          date: e.data.date,
          tags: e.data.tags,
          href: `${CATEGORY_META[key].path}/${e.id}/`,
        });
      }
    }
  }

  // 注意：这里参数用原始标签名，不要 encodeURIComponent，
  // 否则构建出的目录名会变成 %E6%B6%B2%E5%86%B7 这种，链接会 404。
  return [...map.entries()].map(([tag, entries]) => ({
    params: { tag },
    props: { tag, entries },
  }));
}

const { tag, entries } = Astro.props;
---
<BaseLayout title={`#${tag}`} description={`标签 ${tag} 下的所有内容`}>
  <section class="hero">
    <div class="wrap">
      <p class="hero-kicker">Tag</p>
      <h1>#{tag}</h1>
      <p>共 {entries.length} 篇</p>
    </div>
  </section>
  <div class="wrap section">
    <EntryList entries={entries} />
  </div>
</BaseLayout>
